# Line-ending normalisation. Without this, a clone on Windows converts
# terminalcolors.sh to CRLF and bash fails with "$'\r': command not found".

* text=auto eol=lf

# The PowerShell world is CRLF, and the module must stay readable by Windows
# PowerShell 5.1 as well as by Windows editors.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Shell scripts: LF required, including on a Windows machine.
*.sh    text eol=lf

*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf

# Binaries
*.png   binary
*.ico   binary
*.gif   binary
